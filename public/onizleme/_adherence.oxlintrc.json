{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand/**",
              "components/aile/**",
              "components/anasayfa/**",
              "components/dugme/**",
              "components/form/**",
              "components/foto/**",
              "components/gezinti/**",
              "components/hiyerarsi/**",
              "components/icerik/**",
              "components/kabuk/**",
              "components/kapak/**",
              "components/liste/**",
              "components/urun/**",
              "components/veri/**",
              "components/yuzey/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|Schibsted Grotesk|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Onest, Schibsted Grotesk, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdetKontrolu'] > JSXAttribute > JSXIdentifier[name!=/^(?:deger|varsayilan|min|max|adim|onDegisim|etiket|style|key|ref|className|style|children)$/]",
        "message": "<AdetKontrolu> doesn't accept that prop. Declared props: deger, varsayilan, min, max, adim, onDegisim, etiket, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnaEylemDugmesi'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|href|tam|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<AnaEylemDugmesi> doesn't accept that prop. Declared props: children, onClick, href, tam, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnaEylemDugmesi'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<AnaEylemDugmesi> type must be one of 'button' | 'submit'."
