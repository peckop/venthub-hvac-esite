# CodeGraph/Orion SQLite WAL yan-dosyaları — çalışma anında üretilir, asla commitlenmez
# (memory.db kasıtlı tracked snapshot kalır; -shm/-wal ephemeral'dır)
.cc/*.db-shm
.cc/*.db-wal

# Claude Code: sadece makineye özel yerel ayar repoya girmez.
# Skill'ler (.claude/skills) git'te kalır — cihaz çökerse kaybolmasın (.agent gibi).
.claude/settings.local.json

# Yerel scratch / cache / ekran görüntüleri
cache/
# src/lib/cache kaynak kodudur (F5-B cache tag SSOT) — genel cache/ kuralından muaf
!src/lib/cache/
!src/lib/cache/**
explorer_m2_3/
explorer_m4_*/
docs/screenshots/*.png

# Guard ON/OFF anahtari (yerel toggle, commitlenmez)
.claude/hooks/guard.state

# Orion/cc yerel hafiza DB — 225MB'a sisti, repo'da yeri yok (yerel kalir)
.cc/memory.db

# Kok dizin scratch scriptleri (oturum kalintilari)
/_*.py

