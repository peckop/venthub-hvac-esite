#!/bin/sh
# Orion Auto-Doc Post-Commit — YEREL ONLY (NotebookLM sync KASITLI kaldırıldı)
#
# NEDEN: --nlm-sync ağ + NotebookLM auth gerektirir. Mekanik post-commit hattı,
# auth düştüğünde SESSİZCE başarısız olur (.git/orion-sync.log'a
# "nlm_sync_performed: true" yazar ama hiçbir şey yüklemez) — kimse fark etmez,
# çünkü döngüde akıl (LLM/insan) yok. Twin sessizce eskir.
#
# YENİ MODEL — NLM sync artık LLM-güdümlü MILESTONE eylemi:
#   1) notebooklm list --json   (auth GERCEKTEN canli mi; olduyse: notebooklm login)
#        (auth tazele — penceresiz ~15sn, şifre girişi yok)
#   2) orion doc tree --nlm-sync --force-sync --repo-root <REPO_ROOT>
#   3) notebook_query ile twin'i sorgulayıp gerçekten güncellendiğini DOĞRULA
# Tetikleyici: `notebooklm-sync` skill'i, ya da kullanıcı "twin'i güncelle".
#
# Bu hook artık SADECE yerel system_tree.md'yi tazeler — ağ yok, auth yok,
# sessiz-fail yok, commit yavaşlamaz.

REPO_ROOT=$(git rev-parse --show-toplevel)

# Python yorumlayıcısını seç (yerel .venv tercih)
if [ -f "$REPO_ROOT/.venv/Scripts/python" ]; then
    PYTHON_EXEC="$REPO_ROOT/.venv/Scripts/python"
elif [ -f "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON_EXEC="$REPO_ROOT/.venv/bin/python"
else
    PYTHON_EXEC="python"
fi

# 2026-08-15: iki düzeltme.
#
# (1) LOG YOLU — `$REPO_ROOT/.git` bir WORKTREE'de dizin değil DOSYADIR; bu yüzden
#     yönlendirme her worktree commit'inde "Not a directory" hatası veriyordu ve log
#     hiç yazılmıyordu. Doğrusu `git rev-parse --git-dir`.
#
# (2) COMPANION ÜRETİMİ BURAYA TAŞINDI. Eskiden `pre-commit` içindeki `doc run-hook`
#     yapıyordu ve `exit $?` ile commit'i BLOKLUYORDU — reddetme ölçütü bir LLM kalite
#     skoruydu, yani aynı dosya bir koşuda 80/100 alıp commit'i reddedip diğerinde
#     100/100 alabiliyordu. Rastgele patlayan kapı `--no-verify` alışkanlığı doğurur ve
#     GERÇEK kapıları da birlikte atlatır. Üretimin kendisi değerli, BLOKLAMASI değil:
#     artık commit'ten SONRA, arka planda koşuyor. Gerekçenin tamamı: `pre-commit` başlığı.
GIT_DIR_ABS=$(git rev-parse --absolute-git-dir)

# Companion kapsam süzgeci — `post-merge` ile PAYLAŞILAN tek uygulama (T166-VH).
DOC_SCOPE="$REPO_ROOT/.githooks/lib/doc-scope.cjs"

# Companion BAŞARISIZLIK defteri — üretimi geri getirmez, SESSİZ olmaktan çıkarır (REC-67).
DEFTER="$REPO_ROOT/.githooks/lib/companion-defter.cjs"

# ⭐UYKU KİPİ — TAŞIYICI ANAHTARI (REC-142, Recep kararı 2026-09-05).
#
# NİÇİN: taşıyıcı 2026-08-28'de kapandı ama bu kanca ÜRETMEYE DEVAM ETTİ. Sonuç ölçüldü
# (09-05): 37 çalışma ağacında 412 bekleyen değişiklik, 368'i .md — yani kanca her commit'te
# üretemediği companion'ın yerine ağacı kirletti ve kimse temizlemedi. Ayrıca üretilen
# `system_tree.md` şeritlerin ağacını kirletip "kim dosyamı değiştirdi" alarmı doğurdu.
# Uyku kipinde bu kanca HİÇBİR ŞEY üretmez; tek satır log bırakır.
#
# ⚠OKUNAMAZSA "ACIK" VARSAYILIR — kapılarla AYNI yön, tek kural: *anahtar okunamıyorsa
# sistem uyanık davranır.* Üretim çalışır (eski davranış) ve kapılar bloklar; yani hata
# gürültülü olur. Ters yön sessizce üretimi durdurup kimseye söylemezdi.
ANAHTAR_MODUL="$REPO_ROOT/scripts/hijyen/tasiyici-anahtari.cjs"
TASIYICI_DURUM="ACIK"
if [ -f "$ANAHTAR_MODUL" ]; then
    TASIYICI_DURUM=$(node -e "process.stdout.write(require(process.argv[1]).oku(process.argv[2]).durum)" "$ANAHTAR_MODUL" "$REPO_ROOT" 2>/dev/null || echo "ACIK")
fi
if [ "$TASIYICI_DURUM" = "KAPALI" ]; then
    {
        echo ""
        echo "=== $(git rev-parse --short HEAD) $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
        echo "[post-commit] UYKU KIPI — companion/tree URETIMI YOK (anahtar: .companion-tasiyici.json)."
        echo "[post-commit]   Borc silinmedi, ertelendi; kapilar sayiyor. Uyandirma: docs/standards/companion-doc-standard.md"
    } >> "$GIT_DIR_ABS/orion-doc.log"
    exit 0
fi

(
    "$PYTHON_EXEC" -m orion.cli.main doc tree --repo-root "$REPO_ROOT" > "$GIT_DIR_ABS/orion-tree.log" 2>&1
    # ⭐LOG ARTIK KIRPILMIYOR — ölçülmüş kusur (2026-08-31, REC-67). Eskiden burada
    # `: > orion-doc.log` vardı: her commit logu SIFIRLIYORDU, dolayısıyla BAŞARISIZ bir
    # commit'in kanıtı bir SONRAKİ commit tarafından yok ediliyordu. Üreteç 08-28'de durdu ve
    # üç gün fark edilmedi; kanıtı ararken logu boş bulmak bu yüzdendi. Artık her koşum bir
    # BAŞLIKLA eklenir ve log son 400 satıra budanır (kanıt yaşar, dosya şişmez).
    {
        echo ""
        echo "=== $(git rev-parse --short HEAD) $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
    } >> "$GIT_DIR_ABS/orion-doc.log"
    # ÖLÇÜLDÜ: `doc run-hook` ÇALIŞMA AĞACINDAKİ değişikliklere bakar ("değişen dosyaları
    # belgeler"). Commit'ten SONRA ağaç temizdir → hiçbir şey yapmaz, log 0 bayt kalır.
    # Sessizce hiçbir şey yapan kanca, olmayan kancadan kötüdür. Bu yüzden son commit'in
    # dosyaları `doc batch`e AÇIKÇA veriliyor (batch pozisyonel FILES kabul ediyor).
    #
    # KAPSAM SÜZGECİ ARTIK BURADA YAZILI DEĞİL — `.githooks/lib/doc-scope.cjs`'te (T166-VH).
    # Eskiden burada `grep -E '\.(ts|tsx|mjs|cjs)$' | grep -v '\.test\.' | grep -v '__tests__'`
    # zinciri vardı ve `post-merge`de o zincirin TEST SÜZGECİ YOKTU. İki yerde iki uygulama =
    # sürükleniyor: bu kanca öğrendi, öteki öğrenmedi ve filo bir gün boyunca "kim dosyamı
    # kirletti" alarmı yağdırdı (gerçek yazar post-merge'di). Süzgeç tek yerde durur, iki
    # kanca da ORAYA sorar. Kapsamın SSOT'u `.cc_docs.yaml`.
    if [ ! -f "$DOC_SCOPE" ]; then
        echo "[post-commit] ⚠ KAPSAM SUZGECI YOK ($DOC_SCOPE) — companion uretimi ATLANDI." > "$GIT_DIR_ABS/orion-doc.log"
        echo "[post-commit]   Sebebi bu dal .githooks/lib/doc-scope.cjs'i icermiyor olabilir." >> "$GIT_DIR_ABS/orion-doc.log"
        echo "[post-commit]   SESSIZCE SUZGECSIZ URETMIYORUM: suzgecsiz uretim tam da onarilan arizadir." >> "$GIT_DIR_ABS/orion-doc.log"
    else
        CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD | DOC_SCOPE_KOK="$REPO_ROOT" node "$DOC_SCOPE" 2>>"$GIT_DIR_ABS/orion-doc.log" || true)
        if [ -n "$CHANGED" ]; then
            # ⭐ARIZA ÇIKIŞ KODUNDAN TESPİT EDİLEMEZ — ölçüldü (2026-08-31, REC-67):
            # `doc batch` çıkış kodu 0 döner ve `"status": "SUCCESS"` basar, AYNI ÇIKTIDA
            # `Basarili: 0, Basarisiz: 1` yazarken. Bu yüzden çıktı bir dosyaya alınır,
            # loga eklenir ve SINIFLANDIRMA İÇİN deftere borulanır. `|| true` yok:
            # çıkış kodu zaten bilgi taşımıyor, ona bakmıyoruz.
            BATCH_CIKTI="$GIT_DIR_ABS/orion-doc.son.txt"
            # shellcheck disable=SC2086
            "$PYTHON_EXEC" -m orion.cli.main doc batch $CHANGED > "$BATCH_CIKTI" 2>&1
            cat "$BATCH_CIKTI" >> "$GIT_DIR_ABS/orion-doc.log"
            if [ -f "$DEFTER" ]; then
                DOSYA_SAYISI=$(printf '%s\n' "$CHANGED" | grep -c . || true)
                node "$DEFTER" --git-dir "$GIT_DIR_ABS" --dosya "$DOSYA_SAYISI" \
                    < "$BATCH_CIKTI" >> "$GIT_DIR_ABS/orion-doc.log" 2>&1
            else
                echo "[post-commit] ⚠ COMPANION DEFTERI YOK ($DEFTER) — basarisizlik KAYDEDILMEDI." \
                    >> "$GIT_DIR_ABS/orion-doc.log"
            fi
        else
            echo "[post-commit] belgelenecek kaynak dosya yok" >> "$GIT_DIR_ABS/orion-doc.log"
        fi
    fi
    # Log budama: kanıt yaşar, dosya şişmez.
    if [ -f "$GIT_DIR_ABS/orion-doc.log" ]; then
        tail -n 400 "$GIT_DIR_ABS/orion-doc.log" > "$GIT_DIR_ABS/orion-doc.log.tmp" 2>/dev/null \
            && mv "$GIT_DIR_ABS/orion-doc.log.tmp" "$GIT_DIR_ABS/orion-doc.log"
    fi
) &
