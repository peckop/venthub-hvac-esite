#!/bin/sh
# Orion Auto-Doc — PRE-COMMIT
#
# 2026-08-15'te YENİDEN YAZILDI. Öncesi: `.git/hooks/pre-commit.oncesi-2026-08-15`
#
# NİÇİN DEĞİŞTİ — üçü de ölçülerek görüldü, tahmin değil:
#
#  1) KAPI DETERMİNİSTİK DEĞİLDİ. Son adım `doc run-hook` idi ve `exit $?` ile commit'i
#     bloklıyordu. Reddetme ölçütü bir **LLM kalite skoru**: aynı dosya (shipping-notification)
#     batch'te 80/100 alıp commit'i reddetti, elle koşulunca 100/100 aldı. Aynı girdi, iki
#     sonuç. Rastgele patlayan kapı, kapısızlıktan KÖTÜDÜR: `--no-verify` alışkanlığı
#     kazandırır, o da i18n paritesi/lint gibi GERÇEK kapıları birlikte atlatır.
#
#  2) ÜÇ DALDAN İKİSİ ZATEN ÖLÜYDÜ. `doc schema` ve `doc batch` alt komutlarında
#     `--workspace` diye bir seçenek YOK (`doc <cmd> --help` ile doğrulandı) — ikisi de her
#     koşuda "No such option" ile hata veriyor, çıkış kodu kontrol edilmediği için SESSİZCE
#     geçiliyordu. Yani migration şema dokümanı bu kanca ile hiç güncellenmemiş.
#     Klasik "kapı var sanıyorsun, yok" vakası.
#
#  3) YANLIŞ ANDI. Doküman üretimi ağ + LLM gerektirir ve dakikalar sürer; commit hızlı ve
#     çevrimdışı çalışabilmelidir. Üretimin kendisi değerli; BLOKLAMASI değil. Bu yüzden
#     üretim silinmedi, `post-commit`e arka plana taşındı.
#
# ŞİMDİ NE YAPIYOR: hızlı, çevrimdışı, DETERMİNİSTİK bir uyarı. Companion dokümanı hiç
# olmayan yeni kaynak dosyaları listeler ve GEÇER. Skora bakmaz; varlığa bakar.
# Doküman üretimi post-commit'e TAŞINDI (arka planda, bloklamaz; log .git/orion-doc.log).
# İstendiğinde elle:
#     orion doc all --changed-only
#
# BLOKLAMA EKLEMEK İSTERSEN: ölçütün deterministik olduğundan emin ol. LLM çıktısının
# puanı ölçüt olamaz.

REPO_ROOT=$(git rev-parse --show-toplevel)

STAGED=$(git diff --cached --name-only --diff-filter=A | grep -E '^(src|supabase/functions|scripts)/.*\.(ts|tsx|mjs|cjs)$' | grep -v '\.test\.' | grep -v '__tests__')

EKSIK=""
for f in $STAGED; do
    MD=$(echo "$f" | sed -E 's/\.(ts|tsx|mjs|cjs)$/.md/')
    if [ ! -f "$REPO_ROOT/$MD" ]; then
        EKSIK="${EKSIK}  - ${MD}\n"
    fi
done

if [ -n "$EKSIK" ]; then
    echo "[ORION-HOOK] Bilgi: bu YENİ dosyaların companion dokümanı yok:"
    printf "%b" "$EKSIK"
    echo "[ORION-HOOK] post-commit bunları ARKA PLANDA üretir (log: .git/orion-doc.log)."
    echo "[ORION-HOOK] Hemen istersen: orion doc all --changed-only"
    echo "[ORION-HOOK] Bu bir UYARI — commit engellenmedi (bkz. dosya başındaki gerekçe)."
fi

# ------------------------------------------------------- COMMIT ÖNCESİ UYARILAR (REC-267)
# İki kol, ikisi de UYARI: (1) yeni betik araç envanterinde ilan edilmemiş, (2) şerit önekli
# dal ANA REPO ağacında. İkisi de 2026-09-08'de sahada ölçüldü; birincisine bir günde DÖRT
# şerit takıldı (dördüncüsü kapıyı yazan kişi), ikincisi iki şeritte çalışma ağacı kaymasına
# yol açtı ve yalnız DİSİPLİNLE yakalandı.
#
# NİÇİN ŞERİT KAPISINDAN ÖNCE: aşağıdaki kapı BLOKLAR. Bloklayan bir çıktının ardına
# eklenen uyarı, commit reddedildiğinde ekranın yukarısında kalır ve okunmaz.
#
# Betiğin kendisi daima çıkış 0 verir; yine de çıkış kodu BURADA kontrol edilmiyor —
# bilerek. Bu satırın bir gün commit'i durdurması, betikte bir kaza olduğu anlamına gelir
# ve o kaza sessizce herkesin commit'ini bloklamasın.
node "$REPO_ROOT/scripts/hijyen/commit-oncesi-uyarilar.cjs" || true

# ---------------------------------------------------------------- ŞERİT KAPISI (E1)
# YUKARIDAKİ companion kontrolü UYARI-ONLY kalır. Aşağıdaki şerit kontrolü BLOKLAR — ve
# bu, dosyanın başındaki "bloklama eklemek istersen ölçütün deterministik olsun" şartını
# karşıladığı için meşrudur: aynı staged liste + aynı pano = hep aynı sonuç. Ağ yok, LLM yok.
#
# NİÇİN İKİNCİ KATMAN GEREKLİ (ölçüldü, 2026-08-23): PreToolUse kancaları ARACA bakar
# (Edit/Write/Bash). Ama dosya üçüncü bir yoldan da değişebilir — bir git kancasının
# çalıştırdığı üreteç. Companion üreteci tam bunu yaptı ve hiçbir PreToolUse kapısı görmedi.
# pre-commit ARACA değil DOSYA LİSTESİNE bakar; yazının nasıl yapıldığı önemsizdir.
#
# Kimlik yoksa FAIL-OPEN çalışır ama SESSİZ DEĞİL: uyarı basar ve panoya iz bırakır.
node "$REPO_ROOT/scripts/board/lane-precommit.cjs"
LANE_RC=$?
if [ $LANE_RC -ne 0 ]; then
    exit $LANE_RC
fi

# -------------------------------------------------- STAGED DOSYALARA ESLINT (ALT-108)
# `lint-staged` yüklüydü ve ayarı VARDI (`.lintstagedrc.json`: staged .ts/.tsx/.js/.cjs/.mjs/.jsx dosyalarına
# `eslint --fix`, `src/i18n/dictionaries/*.ts` değişince `pnpm run test:i18n`) ama husky kalkınca (kancalar
# `.githooks/`a taşındı) HİÇBİR kancaya bağlı kalmamıştı: ayar ölü duruyordu (ölçüldü 26 Ekim, ALT-108).
# Bu blok onu OLDUĞU GİBİ bağlar; yapılandırma dosyası korumalıdır (`protect-config`), değiştirilmedi.
# UYARI-ONLY, commit'i ENGELLEMEZ: ölçülen maliyet dosya sayısından bağımsız ~14-16 sn (eslint yapılandırması +
# tailwind eklentisi yüklenir); bu kanca "hızlı, çevrimdışı" ilkesindedir ve gerçek kapı CI'daki `pnpm run lint`
# adımıdır. Bloklamak istenirse önce süre düşürülmeli (ALT-108 kart notu).
# `--no-stash`: lint-staged varsayılanı git stash ile yedek alır; stash yığını worktree'ler arasında PAYLAŞILIR
# (başka oturumun girdisine dokunma riski). `--fix` düzeltmeleri commit'e kendiliğinden eklenir.
# Atlama: VH_LINT_STAGED=0 git commit ... (yalnız bu uyarı adımını atlar; hiçbir kapıyı atlamaz).
# Kurulum yoksa (node_modules yok) sessiz geçmez ama durdurmaz: tek satır bilgi.
if [ "${VH_LINT_STAGED:-1}" != "0" ]; then
    LINT_STAGED_BIN="$REPO_ROOT/node_modules/lint-staged/bin/lint-staged.js"
    if [ -f "$LINT_STAGED_BIN" ]; then
        node "$LINT_STAGED_BIN" --no-stash --concurrent false || {
            echo "[LINT-STAGED] Bilgi: staged dosyalarda ESLint HATASI var (yukarıda). Commit engellenmedi;"
            echo "[LINT-STAGED] CI'daki lint adımı bunu kırmızı sayar. Önce düzelt: pnpm exec eslint <dosya>"
        }
    else
        echo "[LINT-STAGED] Bilgi: node_modules/lint-staged yok (pnpm install çalışmamış); staged lint atlandı."
    fi
fi

exit 0
