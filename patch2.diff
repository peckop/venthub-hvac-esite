     const containerRef = useRef<HTMLDivElement>(null)
     const isInView = useInView(containerRef, { margin: "200px" })

+    // Monitor container dimensions properly instead of global window resize
+    useEffect(() => {
+        if (!containerRef.current) return
+        const ro = new ResizeObserver(() => {
+            // The resize observer triggers when the container finishes rendering
+            // We don't need to do anything, R3F uses its own resize observer, but this helps trigger a React state change if needed, OR we just let R3F handle it. But if R3F needs a nudge, we can dispatch resize only on the canvas? No.
+        })
+        ro.observe(containerRef.current)
+        return () => ro.disconnect()
+    }, [])
