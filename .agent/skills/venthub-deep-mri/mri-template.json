{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "name": "venthub-deep-mri-configuration",
  "description": "Deep MRI katmanı yapılandırması. Röntgen'den (PASS) sonra çalışan ağır, derinleme ve maliyetli performans / dead-code denetleme adımlarını içerir.",
  "execution_rules": {
    "prerequisites": [
      "röntgen-pass"
    ],
    "on_failure": "continue_and_report",
    "report_output_dir": ".agent/reports/mri",
    "block_ci": false
  },
  "modules": {
    "dead_code": {
      "name": "Death Code & Export Analysis (Knip)",
      "command": "pnpm run knip --reporter json",
      "thresholds": {
        "unused_files": 0,
        "unused_dependencies": 0,
        "unused_exports": 0
      },
      "level": "INFO"
    },
    "bundle_analyzer": {
      "name": "Next.js Bundle Analyzer",
      "command": "pnpm run analyze",
      "thresholds": {
        "max_first_load_js": "150kB",
        "max_page_size": "500kB"
      },
      "level": "INFO"
    }
  }
}
