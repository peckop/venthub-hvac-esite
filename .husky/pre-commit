# Minimal pre-commit guard (Husky v10 uyumlu):
# - package-lock.json commitlerini engeller
# - package.json değiştiyse pnpm-lock.yaml'ın da stage edilmesini zorunlu kılar
# - AI Scope Police: Orion Bridge aktif olduğundan artık tam güçte çalışıyor

set -eu

STAGED_FILES=$(git diff --cached --name-only)

# 1) Block package-lock.json
if echo "$STAGED_FILES" | grep -q '^package-lock\.json$'; then
  printf "\033[1;31mError:\033[0m package-lock.json commitlenemez. CI pnpm-lock.yaml kullanıyor.\n"
  printf "Lütfen: git restore --staged package-lock.json\n"
  exit 1
fi

# 2) If package.json changed, ensure pnpm-lock.yaml is staged too
if echo "$STAGED_FILES" | grep -q '^package\.json$'; then
  if ! echo "$STAGED_FILES" | grep -q '^pnpm-lock\.yaml$'; then
    printf "\033[1;33mUyarı:\033[0m package.json değişti ama pnpm-lock.yaml stage edilmemiş.\n"
    printf "pnpm install çalıştırın ve pnpm-lock.yaml dosyasını ekleyin:\n"
    printf "  npx pnpm@10 install && git add pnpm-lock.yaml\n"
    exit 1
  fi
fi

# 3) Otonom Code Quality & Syntax Enforcement (Lint-Staged)
printf "\n🔍 [Lint-Staged] Kod kalitesi ve kural denetimi başlatılıyor...\n"
npx lint-staged || {
  printf "\033[1;31m🚨 LINT ERROR:\033[0m Hatalı/Kuralsız kod tespit edildi. Commit engellendi.\n"
  printf "Lütfen yukarıdaki ESLint hatalarını düzeltip tekrar commit atın.\n"
  exit 1
}

# 3) Otonom Registry Sync (V8 - SAFE MODE)
# NOT: Git pre-commit aşamasında 'git add' yapmak kilitlenmeye (deadlock) yol açar.
# Bu yüzden registry güncellemeleri commit öncesi değil, commit sonrası veya manuel yapılmalıdır.
printf "\n[*] Registry kontrolü atlandı (Manuel tetikleme önerilir: manage_registry.py normalize)\n"

# 4) AI Scope Police Enforcement (Orion Bridge v2 — AKTIF)
if command -v python > /dev/null 2>&1; then
    python registry/pre_commit_scope.py || exit 1
elif command -v python.exe > /dev/null 2>&1; then
    python.exe registry/pre_commit_scope.py || exit 1
else
    printf "\033[1;33m⚠️ Uyarı:\033[0m Python bulunamadı, Scope Police atlandı.\n"
fi

exit 0
