{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(node scripts/board/board.cjs note *)",
      "Bash(git fetch *)",
      "Bash(pnpm test *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm type-check *)",
      "Bash(pnpm lint)",
      "mcp__claude_ai_Vercel__list_deployments",
      "mcp__codegraph__codegraph_explore",
      "mcp__github__get_file_contents",
      "mcp__orion__orion_durum",
      "mcp__claude_ai_Vercel__get_deployment_build_logs",
      "mcp__orion__orion_twin",
      "mcp__claude_ai_Vercel__list_teams",
      "mcp__plugin_supabase_supabase__get_edge_function",
      "mcp__github__get_pull_request",
      "mcp__codegraph__codegraph_callers",
      "mcp__plugin_supabase_supabase__list_edge_functions",
      "mcp__claude_ai_Vercel__list_projects",
      "mcp__claude_ai_Vercel__get_project",
      "mcp__plugin_supabase_supabase__query_logs",
      "mcp__github__get_pull_request_status",
      "mcp__notebooklm-py__chat_ask",
      "mcp__notebooklm-py__notebook_list",
      "mcp__notebooklm-py__notebook_get",
      "mcp__notebooklm-py__source_list",
      "mcp__notebooklm-py__chat_list",
      "mcp__notebooklm-py__chat_get",
      "mcp__notebooklm-py__server_info",
      "Bash(git ls-remote *)",
      "Bash(git push --force-with-lease*)",
      "mcp__claude_ai_Vercel__search_vercel_documentation",
      "mcp__claude_ai_Vercel__get_deployment",
      "mcp__plugin_supabase_supabase__get_project_url",
      "mcp__plugin_supabase_supabase__search_docs",
      "mcp__plugin_supabase_supabase__get_publishable_keys",
      "mcp__plugin_supabase_supabase__generate_typescript_types",
      "mcp__plugin_supabase_supabase__get_advisors",
      "mcp__codegraph__codegraph_status"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-config.cjs",
            "statusMessage": "config-protection"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/lane-guard.cjs",
            "statusMessage": "lane-guard"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/sensitive-path-guard.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bash-write-guard.cjs",
            "statusMessage": "bash-write-guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-board.cjs",
            "statusMessage": "board"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/board-release.cjs",
            "statusMessage": "board-release"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/board-brief.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/accumulate-edits.cjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bash-write-audit.cjs",
            "statusMessage": "bash-write-audit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/son-soz-gate.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/verify-on-stop.cjs",
            "timeout": 120,
            "statusMessage": "verify (eslint --fix + tsc)",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/precompact-durum-kapisi.cjs",
            "statusMessage": "durum kapisi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  }
}
