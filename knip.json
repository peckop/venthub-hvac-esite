{
  "$schema": "https://unpkg.com/knip@3/schema-json-lines.json",
  "project": [
    "src/**/*.{ts,tsx,js,jsx}"
  ],
  "ignore": [
    "**/*.d.ts",
    "docs/**",
    "registry/**",
    ".next/**",
    ".agent/**"
  ],
  "ignoreBinaries": [
    "cross-env"
  ],
  "ignoreDependencies": [
    "clsx",
    "tailwind-merge",
    "tailwindcss-animate",
    "@types/node"
  ]
}
